# Copy to .env (gitignored) and fill in to run live against an OpenAI-compatible
# /v1 gateway (a self-hosted 9router, OpenAI itself, etc.). The OpenAI SDK reads
# OPENAI_API_KEY and OPENAI_BASE_URL automatically.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://your-gateway.example/v1

# The model the LLM-as-Router brain uses — keep it cheap; it routes to the pricier ones.
ACROUTER_ROUTER_MODEL=cc/claude-haiku-4-5-20251001
